# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///instance/resqai.db

# Groq AI Configuration (Optional: system works with local deterministic fallback if omitted)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Emergency Dispatch & Routing Configuration
ACK_TIMEOUT_SECONDS=45
MAX_REASSIGN_ATTEMPTS=3
AUTO_DISPATCH_ENABLED=true

# Notification & Audio Buzzer
BUZZER_REPEAT_INTERVAL=10
DEFAULT_ALERT_RADIUS_KM=25
